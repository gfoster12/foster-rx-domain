rules_version = '2';
// Foster Rx public data rules.
// public_envelopes/{cert_id} holds ONLY the signed, public certificate
// envelope projection (payload, canonical_form_b64, signature_hex,
// signing_key_fingerprint, signature_algorithm). It is world-readable by
// design: the verify page reads it client-side and checks the Ed25519
// signature in-browser. Nothing here is secret and nothing is forgeable
// (the signature is verified against the published trust anchor).
//
// Everything else — including `certificates/{id}` which carries
// human_review_record and internal_metadata — is denied to clients.
// Server-side access uses Admin SDK / IAM and bypasses these rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /public_envelopes/{certId} {
      allow read: if true;
      allow write: if false;   // writes only via Admin SDK (certify hook / backfill)
    }
    // template_requests: the site's specimen-gate capture. CREATE only,
    // strict shape, hard size caps. Never readable by clients - an open
    // create endpoint with no read is harvest-proof by construction. The
    // founder reads submissions via console/Admin, which bypasses rules.
    match /template_requests/{requestId} {
      allow create: if request.resource.data.keys().hasOnly(
            ['name', 'email', 'organization', 'role', 'requested_at', 'source'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 200
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 5
        && request.resource.data.email.size() <= 200
        && request.resource.data.organization is string
        && request.resource.data.organization.size() >= 2
        && request.resource.data.organization.size() <= 200
        && request.resource.data.role is string
        && request.resource.data.role.size() <= 200
        && request.resource.data.requested_at is timestamp
        && request.resource.data.source is string
        && request.resource.data.source.size() <= 40;
      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
