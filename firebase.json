{
  "hosting": {
    "site": "fosterrx-prod",
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".firebase/**",
      "**/.*",
      "**/node_modules/**",
      "og-image.html",
      "README.md",
      "LICENSE",
      ".github/**",
      "verify/_test.html",
      "assets/verify/fixtures/**",
      "*.py",
      "tools/**",
      "docs/**",
      "**/*.rules",
      "**/*.bak*",
      "**/*.log",
      ".git/**",
      ".claude/**"
    ],
    "headers": [
      {
        "source": "/intelligence/comp360/structure{,/**}",
        "headers": [
          {"key": "X-Robots-Tag", "value": "noindex"}
        ]
      },
      {
        "source": "/.well-known/**",
        "headers": [
          {"key": "Content-Type", "value": "application/x-pem-file"},
          {"key": "Cache-Control", "value": "public, max-age=3600"},
          {"key": "Access-Control-Allow-Origin", "value": "*"}
        ]
      }
    ],
    "rewrites": [
      {"source": "/verify/**", "destination": "/verify/index.html"}
    ],
    "cleanUrls": true,
    "trailingSlash": false
  },
  "firestore": [
    {
      "database": "foster-rx-synth",
      "rules": "firestore.rules"
    }
  ]
}
